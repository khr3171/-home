{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "photos": {
      ".read": "query.orderByKey && query.limitToLast != null && query.limitToLast <= 12",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['title', 'description', 'createdAt', 'bytes', 'width', 'height'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
        },
        "bytes": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 98304"
        },
        "width": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1024"
        },
        "height": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1024"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "photoData": {
      "$id": {
        ".read": "root.child('photos').child($id).exists()",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isString() && newData.val().length <= 131100 && newData.val().matches(/^data:image\\/(webp|jpeg);base64,[A-Za-z0-9+/=]+$/)"
      }
    },
    "questions": {
      ".indexOn": [
        "owner",
        "isPublic"
      ],
      ".read": "query.limitToLast != null && query.limitToLast <= 20 && ((query.orderByChild === 'isPublic' && query.equalTo === true) || (auth != null && query.orderByChild === 'owner' && query.equalTo === auth.uid) || (auth != null && root.child('admins').child(auth.uid).val() === true))",
      "$id": {
        ".read": "data.child('isPublic').val() === true || (auth != null && (data.child('owner').val() === auth.uid || root.child('admins').child(auth.uid).val() === true))",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('owner').val() === auth.uid && auth.token.firebase.sign_in_provider === 'google.com') || (data.child('owner').val() === auth.uid && !newData.exists()))",
        ".validate": "newData.hasChildren(['owner', 'title', 'body', 'isPublic', 'createdAt'])",
        "owner": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
        },
        "isPublic": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() <= now && newData.val() >= now - 60000) || newData.val() === data.val())"
        },
        "answer": {
          ".validate": "root.child('admins').child(auth.uid).val() === true && newData.hasChildren(['body', 'updatedAt'])",
          "body": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
